{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "git fetch --force origin refs/heads/main:refs/remotes/origin/main && pnpm install --frozen-lockfile && eph up"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node tools/claude-worktree-remove.ts"
          }
        ]
      }
    ]
  }
}
