{
  "name": "@starter/agentic",
  "version": "0.0.0",
  "private": true,
  "description": "A Bun, TypeScript, Rust, Elysia, Drizzle, and Postgres monorepo starter designed for parallel coding-agent worktrees.",
  "license": "Apache-2.0",
  "workspaces": [
    "bins/*",
    "libs/*"
  ],
  "scripts": {
    "bootstrap": "bun install --frozen-lockfile && bun run native:ensure",
    "doctor": "bun tools/doctor.ts",
    "dev": "eph dev",
    "dev:server": "bun --hot bins/server/src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint --type-aware --deny-warnings .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "test": "bun test bins libs tools",
    "test:integration": "bun test tests/integration",
    "check": "bun run fmt:check && bun run lint && bun run typecheck && bun run test && bun run rust:check && bun run policy:check && bun run version:check && bun run release:check && bun run db:migrations:check",
    "rust:fmt": "cargo fmt --all",
    "rust:fmt:check": "cargo fmt --all -- --check",
    "rust:check": "cargo check --locked --workspace --all-targets && cargo clippy --locked --workspace --all-targets --all-features -- -D warnings && cargo test --locked --workspace",
    "native:ensure": "bun tools/native-cache.ts",
    "native:build": "bun tools/native-cache.ts --release --force",
    "db:generate": "drizzle-kit generate --config libs/db/drizzle.config.ts",
    "db:migrate": "bun libs/db/src/migrate.ts",
    "db:migrations:check": "bun tools/check-migrations.ts",
    "version:write": "bun tools/write-version.ts",
    "version:check": "bun tools/check-version.ts",
    "release:check": "bun tools/check-release.ts",
    "cli": "bun bins/cli/src/main.ts",
    "build:cli": "bun tools/build-cli.ts",
    "build:server": "bun build bins/server/src/main.ts --target=bun --minify --outfile=dist/server.js",
    "policy:check": "nudge validate && bun tools/check-nudge-rules.ts && nudge check bins libs tools tests crates && bastion validate && eph check"
  },
  "dependencies": {
    "@starter/db": "workspace:*",
    "@starter/native": "workspace:*",
    "@starter/version": "workspace:*"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.7.3",
    "@types/bun": "1.3.14",
    "drizzle-kit": "0.31.10",
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0",
    "oxlint-tsgolint": "0.25.0",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.3.14"
}
